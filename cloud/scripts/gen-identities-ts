#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pyyaml"]
# ///
"""Generate the web UI's display-identity registry from `identities.yaml`.

`identities.yaml` is the source of truth for attribution, but the site can't
fetch it (the client only sees `rules.json`/`meta.json` from the snapshot
bucket). So we bake the *display* fields — short name + GitHub avatar handle —
into a small bundled TS module the frontend imports directly. Attribution data
(aliases, per-user bytes) still flows through the normal pipeline.

Run after editing `identities.yaml`; commit the generated file.
"""
from __future__ import annotations

import json
import re
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]
IDENTITIES = ROOT / "src" / "dt_cloud" / "identities.yaml"
OUT = ROOT.parents[0] / "site" / "src" / "identities.gen.ts"


def short_name(user_id: str, explicit: str | None) -> str:
    """Explicit `name:`, else the capitalized first segment of the id."""
    if explicit:
        return explicit
    return user_id.split("-")[0].capitalize()


def sanitize(alias: str) -> str:
    """Mirror the frontend's `whoToHandle` (Avatar.tsx): lowercase local part,
    runs of non-[a-z0-9_-] collapsed to '-'."""
    return re.sub(r"-+$|^-+", "", re.sub(r"[^a-z0-9_-]+", "-", alias.split("@")[0].lower()))


def main() -> None:
    doc = yaml.safe_load(IDENTITIES.read_text())
    users = doc.get("users") or {}
    registry: dict[str, dict] = {}
    aliased: dict[str, dict] = {}
    for uid, entry in users.items():
        entry = entry or {}
        rec: dict[str, str] = {"u": uid, "name": short_name(uid, entry.get("name"))}
        if entry.get("github"):
            rec["github"] = entry["github"]
        registry[uid] = rec
        # Alias keys resolve ledger `who`s (email local parts) that aren't the
        # canonical id — e.g. a personal-gmail sign-in. Canonical ids win.
        for alias in entry.get("aliases") or []:
            aliased[sanitize(alias)] = rec
    for k, rec in aliased.items():
        registry.setdefault(k, rec)

    body = json.dumps(registry, indent=2, ensure_ascii=False, sort_keys=True)
    OUT.write_text(
        "// GENERATED by cloud/scripts/gen-identities-ts from identities.yaml — do not edit.\n"
        "// Display-only enrichment (short name + GitHub avatar handle) keyed by\n"
        "// canonical user id. Attribution (bytes) still comes from meta/rules.\n"
        "export interface IdentityRec {\n"
        "  u: string  // canonical user id (alias keys point at their canonical rec)\n"
        "  name: string\n"
        "  github?: string\n"
        "}\n\n"
        f"export const IDENTITIES: Record<string, IdentityRec> = {body}\n"
    )
    print(f"wrote {OUT.relative_to(ROOT.parents[0])} ({len(registry)} users)")


if __name__ == "__main__":
    main()
