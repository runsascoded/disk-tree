#!/usr/bin/env python3
"""The 12 h scan (disky.app's `com.runsascoded.disky.scan` job; specs/m3-site.md).

`disk-tree capture -o /` → layer-1 listing shards of the whole boot volume
in R2 (bounded memory, no local disk; `-o` stays on the root filesystem, so
the Data volume isn't walked twice), then `aws/submit` → the Batch ingest
(path index, snapshot, D1 footers). The laptop only walks. The CLI's `du`
reads that path index too (`du -p r2://disk-tree/listing/laptop`), so there's
no separate `disk-tree index` scan blob any more (2026-10-01).

R2 as `AWS_PROFILE=m3` ("disky m3 laptop": `disk-tree` only); the Batch submit
as `AWS_PROFILE=r` (RAC AWS).

Full Disk Access: disky.app runs this as its child, so macOS TCC charges
the walk to the app's one grant (no per-python re-grant after a uv upgrade).
Without FDA the walk silently skips `~/.Trash`,
`~/Library/{Application Support,Containers,…}` — 69 GiB on 2026-09-29.
"""
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

M3 = Path(__file__).resolve().parent.parent
BIN = M3 / '.venv' / 'bin'
R2 = {'DISK_TREE_R2_ENDPOINT_URL': 'https://0dcad5654e9744de6616f74b8df4af63.r2.cloudflarestorage.com'}
HOST = 'm3'   # pinned: launchd sees `mac.lan`, a shell `Mac`
err = lambda *a: print(*a, file=sys.stderr, flush=True)
log = lambda msg: print(f'[{datetime.now(timezone.utc):%FT%TZ}] {msg}', flush=True)


def run(*cmd: str, profile: str, capture: bool = False, **env: str) -> str:
    r = subprocess.run(cmd, env={**os.environ, 'AWS_PROFILE': profile, **R2, **env}, check=True, text=True, capture_output=capture)
    return r.stdout.strip() if capture else ''


def main() -> None:
    # (`--capture-only`, the drainer's post-delete refresh, is now the same run.)
    log('capture')
    # The scan's scope (disky's setting: whole machine or home only) arrives as
    # `DISKY_SCAN_ROOT`; `-o` (stay on one filesystem) only for `/`, where it
    # keeps the Data volume from being walked twice.
    root = os.environ.get('DISKY_SCAN_ROOT', '/')
    out = run(str(BIN / 'disk-tree'), 'capture', *(['-o'] if root == '/' else []), '-q', '-t', 'r2://disk-tree/captures', root, profile='m3', capture=True, DISK_TREE_HOST=HOST)
    capture = out.splitlines()[-1]
    log(f'captured {capture}')
    job = run(str(BIN / 'python'), str(M3 / 'aws' / 'submit'), capture, profile='r', capture=True)
    log(f'submitted Batch job {job}')


if __name__ == '__main__':
    main()
