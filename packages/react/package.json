{
  "name": "@disk-tree/react",
  "version": "0.1.0",
  "description": "Reusable React widgets (Treemap, TimeSeries, StalenessScatter, AgeHistograms) for disk-tree consumers. Accessor-based, chart-lib-free.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./voronoi": "./src/voronoi/index.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "d3-hierarchy": ">=3",
    "d3-voronoi-treemap": ">=1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-voronoi-treemap": "^1.1.2",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "peerDependenciesMeta": {
    "d3-hierarchy": {
      "optional": true
    },
    "d3-voronoi-treemap": {
      "optional": true
    }
  }
}
